+    expectClose(
+      r.annualSummary.methanePriceAt30PctProfitabilityEurPerTon!,
+      (r.annualSummary.annualTotalCostEur * 1.3) / tons,
+      5,
+    );
+
+    const usable0 = perDayAvail;
+    assertFirstDailyRowClose(
+      r,
+      {
